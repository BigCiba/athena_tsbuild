<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/sequence_actions.vts_c" />
	</scripts>
	<Panel class="CustomHudRoot" hittest="false">
		<Panel id="GameplayTextContainer" hittest="false">
			<Panel id="GameplayTextLinesWrapper" hittest="false">
				<ToastManager id="GameplayTextToast" hittest="false" toastduration="3s" maxtoastsvisible="3" maxtoastbehavior="deleteoldest" preservefadedtoasts="true" delaytime="0" addtoaststohead="true" />
			</Panel>
		</Panel>
		<Panel id="ReceiveItemContainer" hittest="false">
			<Panel id="ReceiveItemLinesWrapper" hittest="false">
				<ToastManager id="ReceiveItemToast" hittest="false" toastduration="1.0s" maxtoastsvisible="5" maxtoastbehavior="deleteoldest" preservefadedtoasts="true" delaytime="0" addtoaststohead="false" />
			</Panel>
		</Panel>
		<Panel id="GameStartRequestContainer" hittest="false"/>
		<Panel id="RestartGameRequestContainer" hittest="false"/>
		<!-- 猪猪存钱罐进度提示 -->
		<Panel id="SavingPotContainer" hittest="false"/>
	</Panel>
</root>
