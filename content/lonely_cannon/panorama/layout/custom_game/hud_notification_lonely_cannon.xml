<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/global_style.css" />
		<include src="file://{resources}/styles/custom_game/hud_notification.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/panorama-polyfill.js" />
		<include src="s2r://panorama/scripts/sequence_actions.vts_c" />
		<include src="file://{resources}/scripts/custom_game/hud_notification.js" />
	</scripts>
	<snippets>
		<snippet name="CombatEventPlayerIcon">
			<Panel class="hud_notification CombatEventPlayerIcon" hittest="false" hittestchildren="false">
				<DOTAAvatarImage id="PlayerAvatarImage" nocompendiumborder="true" hittest="false" hittestchildren="false" />
			</Panel>
		</snippet>
		<snippet name="CombatEventItemIcon">
			<Panel class="CombatEventItemIcon" hittest="false" hittestchildren="false">
				<DOTAItemImage id="ItemImage" hittest="false" hittestchildren="false" />
			</Panel>
		</snippet>
		<snippet name="Notification">
			<Panel class="Notification" hittest="false" hittestchildren="false">
				<Panel id="SlashContainer">
					<Panel id="TeamColorBar" />
				</Panel>
				<Label id="NotificationLabel" class="NotificationListLabel" hittest="false" />
				<Panel id="NotificationIcon" />
			</Panel>
		</snippet>
	</snippets>
	<Panel class="notificationRoot HUDFlipped" hittest="false">
		<Panel id="ToastManager" hittest="false">
		</Panel>
		<Panel id="UpperNotificationContainer" hittest="false">
		</Panel>

		<Panel id="CombatNotificationContainer" hittest="false">
			<Panel id="CombatNotificationLinesWrapper" hittest="false">
				<ToastManager id="CombatNotificationToastManager" hittest="false" toastduration="10s" maxtoastsvisible="15" maxtoastbehavior="deleteoldest" preservefadedtoasts="true" delaytime="0" addtoaststohead="false" />
			</Panel>
		</Panel>

		<ToastManager id="RightNotificationContainer" hittest="false" toastduration="8.0s" maxtoastsvisible="3" />

		<Panel id="BottomNotificationContainer" hittest="false">
		</Panel>
		<Panel id="TipsContainer" hittest="false">
		</Panel>

		<Panel id="PlaceNameContainer" hittest="false" hittestchildren="false">
			<Label id="PlaceName" />
		</Panel>
	</Panel>
</root>