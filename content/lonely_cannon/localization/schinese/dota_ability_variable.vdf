		// 特殊效果
		"feature_Attack"					"攻击"
		"feature_Attack_description"		"使用你的武器进行普通攻击"
		"feature_Skill"						"特技"
		"feature_Skill_description"			"英雄技能"
		"feature_Dodge"						"冲刺"
		"feature_Dodge_description"			"英雄技能，冲刺期间免疫弹幕"
		"feature_Defense"					"防御"
		"feature_Defense_description"		"英雄技能"
		"feature_Ultimate"					"绝招"
		"feature_Ultimate_description"		"英雄技能"
		"feature_Ring"						"环绕物"
		"feature_Ring_description"			"围绕英雄旋转的物体，对接触到的敌人造成伤害"
		"feature_Split"						"散射"
		"feature_Split_description"			"多投射物或多目标的技能效果"
		"feature_Shield"					"护盾"
		"feature_Shield_description"		"可以抵挡伤害，每<Constant|SHIELD_DECAY_INTERVAL/>秒会衰减<Constant|SHIELD_DECAY_RATE/>%，强效护盾不会自然衰减"
		"feature_StrongShield"				"强效护盾"
		"feature_StrongShield_description"	"可以抵挡伤害，强效护盾不会自然衰减"
		"feature_Backstab"					"背刺"
		"feature_Backstab_description"		"从背后发动的攻击"
		"feature_Electric"					"触电"
		"feature_Electric_description"		"下次受到的伤害提升<Constant|EXPOSE_DAMAGE_PCT/>%，触发后消耗一层"
		"feature_Hit"						"受击"
		"feature_Hit_description"			"受到伤害或规避伤害时触发的效果"
		"feature_Hurt"						"受伤"
		"feature_Hurt_description"			"受到伤害且造成生命值降低时触发的效果"
		"feature_Counter"					"反击"
		"feature_Counter_description"		"受击后进行的反击效果，会受到反击相关的加成，每种反击效果有<Constant|COUNTER_CD/>秒的冷却"
		"feature_Frozen"					"冰冻"
		"feature_Frozen_description"		"减速目标并增加受到的伤害(最大<Constant|FROZEN_DAMAGE_AMPLIFY_MAX/>%)，施加冰冻时造成伤害，每<Constant|FROZEN_DECAY_INTERVAL/>秒会衰减<Constant|FROZEN_DAMAGE_AMPLIFY_MAX/>%"
		"feature_Freeze"					"冻结"
		"feature_Freeze_description"		"被冻结的单位无法移动和攻击"
		"feature_Crit"						"暴击"
		"feature_Crit_description"			"暴击造成150%"
		"feature_Fury"						"怒气"
		"feature_Fury_description"			"通过攻击和技能积累怒气，怒气填充满后可以释放<Ultimate:绝招/>"
		"feature_Burning"					"燃烧"
		"feature_Burning_description"		"使目标持续受到伤害，无法叠加"
		"feature_Bleed"						"流血"
		"feature_Bleed_description"			"流血单位每秒受到伤害，每移动一定距离会额外受到一次伤害"
		"feature_Poison"					"中毒"
		"feature_Poison_description"		"中毒单位每秒受到伤害，每次结算伤害后中毒层数会衰减<Constant|POISON_DECAY_RATE/>%"
		"feature_BladeWave"					"剑气"
		"feature_BladeWave_description"		"每秒还会积累一层剑意，每层使下次剑气伤害和距离提高<Constant|SWORD_INTENT_PCT_PER_STACK/>%，最多<Constant|SWORD_INTENT_MAX_STACK/>层"
		"feature_ShootDown"					"击落"
		"feature_ShootDown_description"		"击落敌人普通的攻击弹道和部分技能弹道"
		"feature_Reflect"					"反弹"
		"feature_Reflect_description"		"反弹敌人普通的攻击弹道和部分技能弹道"
		"feature_Infect"					"传染"
		"feature_Infect_description"		"将自身的剩余中毒层数传染给其他单位"
		"feature_Weak"						"虚弱"
		"feature_Weak_description"			"每层虚弱减少<Constant|WEAK_REDUCE_DAMAGE_PCT/>%造成的伤害，每层持续<Constant|WEAK_DURATION/>秒，最多<Constant|WEAK_MAX_STACK/>层。"
		"feature_Multiple"					"多重"
		"feature_Multiple_description"		"该效果会重复触发多次"
		"feature_DamageIntensity"			"伤害强度"
		"feature_DamageIntensity_description"			"每10点伤害强度增加1%的伤害提升，与其他伤害类加成乘法计算。"
		"feature_DefenseIntensity"			"防御强度"
		"feature_DefenseIntensity_description"			"每10点防御强度增加1%的最大生命值和护盾加成，与其他生命/护盾类加成乘法计算。"
		"feature_Intensity"			"强度"
		"feature_Intensity_description"			"每1点钥匙强度会提高所有怪物最大生命值和攻击力"
		"feature_Durability"			"耐久度"
		"feature_Durability_description"			"使用钥匙进入关卡，则会扣除1点耐久度，归0钥匙将直接被摧毁，钥匙可通过吞噬提高耐久度"
		"feature_Numeradd"			"数值提高"
		"feature_Numeradd_description"			"当装备上的副属性有符合要求的属性时，所有对应属性都会提高对应数值"
		"feature_DrawingChance"            "图纸掉落概率"
		"feature_DrawingChance_description"			"获得任意混沌装备时，有对应概率获得装备图纸（每件混沌装备单独计算概率）"
		"feature_GemRollChance"            "宝石高数值概率"
		"feature_GemRollChance_description"			"宝石遗迹结算时，宝石属性有对应概率提升1档颜色品质；判定成功后，将继续以相同概率判定，直到失败后停止判定（宝石每条属性单独计算概率）"
		"feature_Healthy"					"健康"
		"feature_Healthy_description"		"生命值高于<Constant|HEALTHY_PCT/>%的单位"
		"feature_LowHealth"					"危血"
		"feature_LowHealth_description"		"生命值低于<Constant|LOW_HEALTH_PCT/>%的单位"
		"feature_Stun"						"晕眩"
		"feature_Stun_description"			"晕眩不对"
		"feature_Bounce"					"反弹"
		"feature_Bounce_description"		"弹道遇到障碍物后会反弹，反弹后可以再次造成命中效果"
		"feature_Punishment"				"天罚"
		"feature_Punishment_description"	"使目标收到<Constant|PUNISHMENT_DAMAGE/>点无视<Shield:护盾/>的伤害"
		"feature_Blind"						"致盲"
		"feature_Blind_description"			"使敌人无法索敌"
		"feature_Discount"					"折扣"
		"feature_Discount_description"		"商店折扣只取最大值，不会叠加"
		"feature_IceMark"					"霜冻印记"
		"feature_IceMark_description"		"造成冰冻伤害时爆裂，使该次伤害提升<Constant|ICE_MARK_DAMAGE/>点，触发后消耗一层"

		"feature_charge"					"充能"
		"feature_charge_description"		"释放技能获得充能，用于给集齐“释放”羁绊的技能增伤"
		"feature_active"					"释放"
		"feature_active_description"		"通过集齐“充能”羁绊的技能获得充能，从而给集齐“释放”羁绊的技能增伤"
		"feature_substitute"				"痛击"
		"feature_substitute_description"	"释放技能积攒点数，达到特定点数下次造成双倍伤害，不同技能的痛击点数独立计算"
		"feature_vulnerable"				"易伤"
		"feature_vulnerable_description"	"技能命中敌人施加易伤，使其受到的伤害提高"
		"feature_weaken"					"削弱"
		"feature_weaken_description"		"技能命中敌人施加易伤，使其速度和伤害降低"
		"feature_celerity"					"迅捷"
		"feature_celerity_description"		"释放技能使自身提高攻速移速，不同技能施加的迅捷层数累计计算"
		"feature_shieldd"					"防御"
		"feature_shieldd_description"		"释放技能获得护盾，不同技能的触发间隔独立计算"
		"feature_circle"					"阵法"
		"feature_circle_description"		"释放技能积攒点数，达到特定点数生成增伤阵法"
		"feature_Summon"					"召唤物"
		"feature_Summon_description"		"召唤物会受到召唤物攻击速度的影响"
		"feature_Breakable"					"可破坏物"
		"feature_Breakable_description"		"可破坏物包含板条箱，柱子"
		"feature_Quantitylimit"					"唯一"
		"feature_Quantitylimit_description"		"同名物品只能拥有一个"
		"feature_Grouplimit"					"限制"
		"feature_Grouplimit_description"		"无法获得低级或同级遗物"
		"feature_CloseRange"					"近距离"
		"feature_CloseRange_description"		"距离小于<Constant|CLOSE_RANGE/>的单位"
		"feature_FarRange"					"远距离"
		"feature_FarRange_description"		"距离大于<Constant|FAR_RANGE/>的单位"
		"feature_Taunt"					"嘲讽"
		"feature_Taunt_description"		"嘲讽会使目标仇恨转移至嘲讽者"

		"feature_chargepoints"					"充能点数"
		"feature_chargepoints_description"		"不同技能的触发间隔独立计算，但不同技能获得的充能累计计算"
		"feature_vulnerablepoints"					"易伤状态"
		"feature_vulnerablepoints_description"		"不同技能施加的易伤层数累计计算，不同玩家分别计算各自效果和最大叠加层数"
		"feature_circlepoints"					"阵法点数"
		"feature_circlepoints_description"		"已存在阵法情况下，再施加阵法只会替代旧的，但不同玩家之间可以叠加"
	    "feature_Modify"					"转移"
	    "feature_Modify_description"		"符文副属性不再作用于所镶嵌技能，按一定比例转移至指定技能。每枚符文独立计算；同一符文内，同目标比例叠加，多目标分别计算。转回原技能无效。"
	    "feature_Subattribute"					"强化"
	    "feature_Subattribute_description"		"符文装在对应技能上时，仅提高该符文本身的副属性。若该符文会将副属性转移至其他技能，则强化失效；其他符文转入的属性不受强化影响。"
	}
}